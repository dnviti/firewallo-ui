# ------------------------
# Python bytecode / caches
# ------------------------
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.pyd

# ------------------------
# Virtual environments
# ------------------------
.env
.venv/
venv/
env/
ENV/

# ------------------------
# Distribution / packaging
# ------------------------
build/
dist/
pip-wheel-metadata/
*.egg-info/
.eggs/

# ------------------------
# Tool caches
# ------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/
.pyre/

# ------------------------
# Editors / IDE
# ------------------------
.vscode/
.idea/
*.swp
*.swo

# ------------------------
# Logs & runtime artifacts
# ------------------------
*.log
logs/

# ------------------------
# Node (future frontend tooling)
# ------------------------
node_modules/

# ------------------------
# WireGuard & generated configs
# ------------------------
*.conf

# ------------------------
# Local data stores (runtime state, not source)
# ------------------------
app/db/*.db
app/db/metadata.json

# ------------------------
# Environment / secrets (recommend using sample template)
# ------------------------
.env.local
.env.*.local

# ------------------------
# Docker overrides / local compose additions
# ------------------------
docker-compose.override.yml

# ------------------------
# Misc
# ------------------------
*.pid
*.DS_Store
data/
*.txt
*.log
*.log.*
*.log.*
